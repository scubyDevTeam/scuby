# Every key the web client can need, with mock values. Committed on purpose: nothing here is real.
# Real values go in `.env.local` (never committed) or in the Vercel project's env vars.
# A value that is empty or starts with `mock-` counts as "not configured" (src/env.ts),
# so the feature that needs it stays off instead of calling a fake service.
#
# VITE_* keys are bundled into the client and are public by nature. Never put a secret in one.

# --- Brand (docs/product/00 · #21): the product name is configuration ---
VITE_BRAND_NAME=Scuby
VITE_BRAND_SHORT_NAME=Scuby
# Public origin used in share links, QR codes and the poster.
VITE_PUBLIC_ORIGIN=http://localhost:5173

# Where data-protection requests go (Ley 1581 · consultas y reclamos). Shown on the legal pages.
VITE_LEGAL_EMAIL=mock-legal@example.com

# --- API ---
VITE_API_URL=http://localhost:3000
# true = MSW answers every request (no backend needed). Sign-in then accepts the code 123456.
VITE_API_MOCK=true

# --- Sign-in (docs/eng/auth.md) ---
VITE_GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com

# --- Map (MapLibre) ---
# Style JSON of the tile source. OpenFreeMap needs no key. Empty = maps draw without streets.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Web Push (VAPID public key; the private half lives in the backend) ---
VITE_VAPID_PUBLIC_KEY=mock-vapid-public-key

# --- Errors ---
VITE_SENTRY_DSN=mock-sentry-dsn

# --- Build / server side only (CI and Vercel, never bundled) ---
# Sourcemap upload at build time.
SENTRY_AUTH_TOKEN=mock-sentry-auth-token
SENTRY_ORG=mock-sentry-org
SENTRY_PROJECT=mock-sentry-project
# api/share.ts: where the share function fetches the case summary.
SHARE_API_URL=http://localhost:3000
