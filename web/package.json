{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "UPDATE_OPENAPI=1 vitest run src/contracts/openapi.test.ts",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "size": "VITE_API_MOCK=false vite build --outDir dist-size --emptyOutDir --logLevel warn && node scripts/check-size.mjs dist-size",
    "build:share": "node scripts/build-share.mjs",
    "lighthouse": "lhci autorun",
    "check:brand": "sh scripts/check-brand.sh",
    "check:e2e-tags": "node scripts/check-e2e-tags.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm depcruise && pnpm check:brand && pnpm check:copy && pnpm check:e2e-tags && pnpm build && pnpm build:share && pnpm size && pnpm e2e && pnpm lighthouse",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@sentry/react": "11.1.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "lucide-react": "^1.56.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.64.0",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.45",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.6.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^5.0.4",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.27.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
