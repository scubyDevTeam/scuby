{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "size": "size-limit",
    "check:brand": "sh scripts/check-brand.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm depcruise && pnpm check:brand && pnpm build && pnpm size && pnpm e2e",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "lucide-react": "^1.56.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@size-limit/file": "^14.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.45",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.6.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.3",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.27.0",
  "size-limit": [
    {
      "name": "client JS except the lazy map and the dev mock worker (upper bound for /c/:code first load; budget 150 KB)",
      "path": [
        "dist/assets/*.js",
        "!dist/assets/browser-*.js",
        "!dist/assets/MapLibreMap-*.js",
        "!dist/assets/maplibre-gl-*.js",
        "!dist/assets/maplibre-gl-worker-*.js"
      ],
      "limit": "150 KB",
      "gzip": true
    }
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
